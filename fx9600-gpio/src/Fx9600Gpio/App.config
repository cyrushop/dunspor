<?xml version="1.0" encoding="utf-8"?>
<!-- Copied to Fx9600Gpio.exe.config next to the .exe. Edit that file on the PC that runs it. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Reader -->
    <add key="ReaderHost" value="192.168.1.100" />
    <!-- 0 = SDK default: LLRP port 5084, 5000 ms timeout -->
    <add key="ReaderPort" value="0" />
    <add key="ReaderTimeoutMs" value="0" />
    <add key="ReconnectIntervalMs" value="5000" />

    <!-- Lamps: GPO port numbers (Figure 139: pins 3/4/5 = GP O/P #1/#2/#3) -->
    <add key="RedGpo" value="1" />
    <add key="GreenGpo" value="2" />
    <add key="BlueGpo" value="3" />
    <!-- GPO PortState that lights a lamp. Not documented for FX9600: run the wiring test (README) to find out. -->
    <add key="LampOnState" value="true" />

    <!-- Sensors: GPI port numbers (Figure 139: pins 8/9 = GP I/P #1/#2). 0 = not used. -->
    <add key="StartSensorGpi" value="1" />
    <!-- Set to 0 to end the cycle when the start sensor is released instead. -->
    <add key="StopSensorGpi" value="2" />
    <!-- true: sensor contact pulls the GPI to GPIO GND (LOW) when triggered, as in Figure 139 -->
    <add key="SensorActiveLow" value="true" />

    <!-- Read cycle -->
    <add key="MaxReadMs" value="10000" />
    <add key="StopDelayMs" value="300" />
    <add key="MinTags" value="1" />
    <add key="ResultHoldMs" value="2000" />

    <!-- Optional GPI debounce (ms). 0 = leave the reader's setting. Needs the reader's admin login. -->
    <add key="GpiDebounceMs" value="0" />
    <add key="RmUser" value="admin" />
    <add key="RmPassword" value="" />

    <!-- Per-day CSV of read cycles, relative to the .exe folder. Empty = off. -->
    <add key="CycleLogDir" value="logs" />
  </appSettings>
</configuration>
